{
    "executors": [
        {
            "scopes": [
                "localhost:5000"
            ],
            "stores": [
                {
                    "type": "registry-store",
                    "parameters": {
                        "plainHttp": true,
                        "credential": {
                            "provider": "static",
                            "username": "test_user",
                            "password": "test_pw"
                        }
                    }
                }
            ],
            "verifiers": [
                {
                    "name": "notation-1",
                    "type": "notation",
                    "parameters": {
                        "certificates": [
                            {
                                "type": "ca",
                                "files": [
                                    "~/.config/notation/localkeys/ratify-bats-test.crt"
                                ]
                            },
                            {
                                "type": "tsa",
                                "files": [
                                    "~/.ratify/ratify-certs/notation/tsarootca.cer"
                                ]
                            }
                        ]
                    }
                }
            ],
            "policyEnforcer": {
                "type": "threshold-policy",
                "parameters": {
                    "policy": {
                        "rules": [
                            {
                                "verifierName": "notation-1"
                            }
                        ],
                        "threshold": 1
                    }
                }
            }
        }
    ]
}
