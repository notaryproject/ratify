FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine3.23@sha256:7fd63dd7c37f5ddaef15bd8fd3f3e4f90f0d50cd9cae255c7cf73887a494d8df AS builder

WORKDIR /app

COPY . .

RUN go build -o /app/out/ /app/cmd/ratify-gatekeeper-provider

FROM gcr.io/distroless/static:nonroot@sha256:d62067879de890a1def9da0e7766b7d20810a5e5555cef8506b752437d7a3e88

WORKDIR /app

COPY --from=builder /app/out/ratify-gatekeeper-provider ./

EXPOSE 6001

USER 65532:65532

ENTRYPOINT ["/app/ratify-gatekeeper-provider"]
